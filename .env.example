# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Every variable here is optional — the collector runs without any of them.

# Raises GitHub API calls from ~60/hour (anonymous) to 1,000/hour while scanning packs.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Optional model pass (`npm run enrich`): summaries and an SEO relevance audit of the
# skill library. Leave SEO_LLM_KEY empty and the pipeline behaves exactly as before.
# Any OpenAI-compatible provider works; Gemini's free tier needs no card.
#   Gemini:     https://aistudio.google.com/apikey     ~1,500 requests/day
#   Groq:       https://console.groq.com/keys          30 requests/min, 1,000/day
SEO_LLM_KEY=
SEO_LLM_BASE=https://generativelanguage.googleapis.com/v1beta/openai
SEO_LLM_MODEL=gemini-2.5-flash-lite
# Optional limits: skills reviewed per run, and skills per request.
# SEO_LLM_MAX=400
# SEO_LLM_BATCH=20
